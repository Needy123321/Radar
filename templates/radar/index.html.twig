            const isMilitary = p.callsign && p.callsign.includes('[ВОЕНЕН]');
            const color = isMilitary ? '#ff3333' : '#ffcc00';
            const badgeText = isMilitary ? 'ВОЕНЕН ОБЕКТ' : 'ГРАЖДАНСКИ ПОЛЕТ';
            const trackDeg = Math.round(p.track || 0);
            const azimuthDeg = (p.azi || 0).toFixed(1);

            const cachedPhoto = planePhotoCache[p.id];
            const showImg = cachedPhoto ? 'display:block;' : 'display:none;';
            const showSvg = cachedPhoto ? 'display:none;' : 'display:block;';

            const planeSvg = `
                <svg id="fallbackPlaneSvg" viewBox="0 0 64 64" width="42" height="42" style="${showSvg} transform: rotate(${trackDeg}deg); filter: drop-shadow(0 0 4px ${color});">
                    <path fill="${color}" d="M32 4 L36 18 L58 30 L58 35 L36 31 L35 48 L45 55 L45 59 L32 56 L19 59 L19 55 L29 48 L28 31 L6 35 L6 30 L28 18 Z"/>
                </svg>
            `;

            const cycleButtonHtml = overlappingCluster.length > 1
                ? `<button class="action-btn cycle-btn" onclick="cycleNextTarget()">СЛЕДВАЩ (${clusterIndex + 1}/${overlappingCluster.length}) ➔</button>`
                : '';

            const sqkStatus = analyzeSquawkCode(p.squawk, isMilitary);
            let squawkAlertHtml = '';
            if (sqkStatus && (sqkStatus.level === 'emergency' || sqkStatus.level === 'tactical')) {
                const cls = sqkStatus.level === 'emergency' ? 'squawk-emergency' : 'squawk-tactical';
                squawkAlertHtml = `<div class="squawk-alert-box ${cls}">${sqkStatus.desc}</div>`;
            }

            const currentRoute = planeRouteCache[p.id] || 'Търсене на маршрут...';
            const currentPinSlot = getPinSlotForPlane(p.id);

            panel.innerHTML = `
                <div class="panel-top-actions">
                    ${cycleButtonHtml}
                    <button class="action-btn" onclick="closeInfoPanel()">✕</button>
                </div>
                <div class="plane-card-header">
                    <div class="plane-photo-box" title="Снимка / Курс: ${trackDeg}°">
                        <img id="realPlaneImg" src="${cachedPhoto || ''}" style="${showImg}" alt="Снимка на самолета" />
                        ${planeSvg}
                    </div>
                    <div>
                        <div style="font-size: 9.5px; color: ${color}; letter-spacing: 1px; font-weight: bold;">● ${badgeText}</div>
                        <div style="font-weight: bold; font-size: 14px; color: #fff; margin: 2px 0;">
                            📡 SQK: <span style="color:#00ffff;">${p.squawk || '----'}</span> &nbsp;|&nbsp; ✈ ${p.callsign}
                        </div>
                        <div style="font-size: 10.5px; color: #00ffcc; font-weight: bold;">
                            HEX транспондер: ${p.id.toUpperCase()}
                        </div>
                        <div style="font-size: 10px; color: #88ff88;">${p.operator || 'Неизвестен оператор'}</div>
                    </div>
                </div>

                ${squawkAlertHtml}

                <div class="route-banner">
                    <span id="planeRouteText">${currentRoute}</span>
                </div>

                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Азимут (${useMagneticNorth ? 'Магнитен' : 'Истински'}) / Разст.</span>
                        <span class="info-val" style="color:#00ffff;">${azimuthDeg}° / ${p.dist.toFixed(1)} км</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Модел / Тип</span>
                        <span class="info-val">${p.type || 'Няма данни'}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Курс / Височина</span>
                        <span class="info-val">${trackDeg}° / ${p.altitude || 0} м</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Скорост</span>
                        <span class="info-val">${p.speed || 0} км/ч</span>
                    </div>
                </div>

                <div class="mark-targets-row">
                    <button class="mark-btn ${currentPinSlot === 1 ? 'active' : ''}" onclick="togglePinSlot(1, '${p.id}')">🎯 ${currentPinSlot === 1 ? '#1 МАРК' : 'МАРК 1'}</button>
                    <button class="mark-btn ${currentPinSlot === 2 ? 'active' : ''}" onclick="togglePinSlot(2, '${p.id}')">🎯 ${currentPinSlot === 2 ? '#2 МАРК' : 'МАРК 2'}</button>
                    <button class="mark-btn ${currentPinSlot === 3 ? 'active' : ''}" onclick="togglePinSlot(3, '${p.id}')">🎯 ${currentPinSlot === 3 ? '#3 МАРК' : 'МАРК 3'}</button>
                    <button class="mark-btn ${currentPinSlot === 4 ? 'active' : ''}" onclick="togglePinSlot(4, '${p.id}')">🎯 ${currentPinSlot === 4 ? '#4 МАРК' : 'МАРК 4'}</button>
                    <button class="mark-btn ${currentPinSlot === 5 ? 'active' : ''}" onclick="togglePinSlot(5, '${p.id}')">🎯 ${currentPinSlot === 5 ? '#5 МАРК' : 'МАРК 5'}</button>
                    <button class="mark-btn ${currentPinSlot === 6 ? 'active' : ''}" onclick="togglePinSlot(6, '${p.id}')">🎯 ${currentPinSlot === 6 ? '#6 МАРК' : 'МАРК 6'}</button>
                </div>
            `;

            if (cachedPhoto === undefined) {
                fetchRealPlanePhoto(p.id);
            }
            if (planeRouteCache[p.id] === undefined) {
                fetchFlightRoute(p);
            }
        }

        window.closeInfoPanel = function() {
            selectedPlaneId = null;
            overlappingCluster = [];
            document.getElementById('infoPanel').style.display = 'none';
        };

        canvas.addEventListener('pointerup', (e) => {
            if (dragMoved) return;

            const rect = canvas.getBoundingClientRect();
            const cx = screenWidth / 2;
            const cy = mul(screenHeight, 0.50);

            const clickX = sub(sub(sub(e.clientX, rect.left), cx), panX) / scale + cx;
            const clickY = sub(sub(sub(e.clientY, rect.top), cy), panY) / scale + cy;

            const hitRadius = 26 / scale;
            let candidates = [];

            for (let p of planes) {
                if (p.dist > maxRangeKm || !p.renderX || !p.renderY) continue;
                const isMilitary = p.callsign && p.callsign.includes('[ВОЕНЕН]');
                const isPinned = getPinSlotForPlane(p.id) !== null;
                if (highlightMilitaryOnly && !isMilitary && !isPinned) continue;

                const d = Math.hypot(sub(p.renderX, clickX), sub(p.renderY, clickY));
                if (d < hitRadius) {
                    candidates.push({ plane: p, clickDist: d, isMil: isMilitary ? 1 : 0 });
                }
            }

            if (candidates.length > 0) {
                candidates.sort((a, b) => {
                    if (b.isMil !== a.isMil) return sub(b.isMil, a.isMil);
                    return sub(a.clickDist, b.clickDist);
                });

                const newCluster = candidates.map(c => c.plane);

                const currentInClusterIdx = newCluster.findIndex(p => p.id === selectedPlaneId);
                if (currentInClusterIdx !== -1 && newCluster.length > 1) {
                    clusterIndex = (currentInClusterIdx + 1) % newCluster.length;
                } else {
                    clusterIndex = 0;
                }

                overlappingCluster = newCluster;
                const chosen = overlappingCluster[clusterIndex];
                selectedPlaneId = chosen.id;

                const panel = document.getElementById('infoPanel');
                panel.style.display = 'block';
                updateInfoPanelHTML(chosen);
            } else {
                closeInfoPanel();
            }
        });

        function extrapolatePosition(lat, lon, speedKmH, trackDeg, timeDeltaSeconds) {
            if (!speedKmH || speedKmH <= 0) return { lat, lon };
            const distanceKm = mul(speedKmH, timeDeltaSeconds) / 3600;
            const R = 6371;
            const brng = mul(trackDeg, DEG_TO_RAD);
            const lat1 = mul(lat, DEG_TO_RAD);
            const lon1 = mul(lon, DEG_TO_RAD);

            const lat2 = Math.asin(mul(Math.sin(lat1), Math.cos(distanceKm / R)) + mul(mul(Math.cos(lat1), Math.sin(distanceKm / R)), Math.cos(brng)));
            const lon2 = lon1 + Math.atan2(mul(mul(Math.sin(brng), Math.sin(distanceKm / R)), Math.cos(lat1)), sub(Math.cos(distanceKm / R), mul(Math.sin(lat1), Math.sin(lat2))));

            return {
                lat: mul(lat2, RAD_TO_DEG),
                lon: mul(lon2, RAD_TO_DEG)
            };
        }

        function applyNewGpsCoordinates(newLat, newLon) {
            newLat = parseFloat(newLat);
            newLon = parseFloat(newLon);

            if (calculateDistance(myLat, myLon, newLat, newLon) > 10) {
                planes = [];
            }

            myLat = newLat;
            myLon = newLon;
            isRealGps = true;

            const distFromRadishevo = calculateDistance(RADISHEVO_LAT, RADISHEVO_LON, myLat, myLon);
            if (distFromRadishevo <= 10.0) {
                gpsStatusText = `📡 GPS: с. Радишево (${distFromRadishevo.toFixed(1)}км)`;
            } else {
                gpsStatusText = `📡 GPS: Активен (${distFromRadishevo.toFixed(0)}км от Радишево)`;
            }

            fetchPlanes();
        }

        if (navigator.geolocation) {
            navigator.geolocation.watchPosition(
                (position) => {
                    applyNewGpsCoordinates(position.coords.latitude, position.coords.longitude);
                },
                (error) => {
                    if (!isRealGps) {
                        gpsStatusText = "📍 БАЗА: с. Радишево";
                    }
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 5000
                }
            );
        }

        window.updateLocationFromApp = function(lat, lon) {
            applyNewGpsCoordinates(lat, lon);
        };

        updatePinnedBarUI();
        fetchPlanes();
        setInterval(fetchPlanes, 5000);
        requestAnimationFrame(draw);
    </script>
{% endblock %}
