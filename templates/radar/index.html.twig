<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ТАКТИЧЕСКИ ВЪЗДУШЕН РАДАР - БЪЛГАРИЯ</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        :root {
            --neon: #00ff66;
            --neon-bg: rgba(6, 18, 10, 0.92);
            --mil-red: #ff2222;
            --plane-yellow: #ffdd00;
            --warn-amber: #ffaa00;
            --pin-magenta: #ff00ff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            background-color: #08120c;
            color: var(--neon);
            font-family: 'Segoe UI', Tahoma, monospace;
            overflow: hidden;
            position: fixed;
        }

        #terrainMap {
            position: absolute;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 1;
            background: #101c14;
        }

        .map-tactical-filter .leaflet-tile-pane {
            filter: brightness(0.75) contrast(1.14) saturate(0.85);
        }

        .bg-border-glow {
            filter: drop-shadow(0 0 6px #ff0000) drop-shadow(0 0 12px rgba(255, 0, 0, 0.8));
        }

        #radarCanvas {
            position: absolute;
            inset: 0;
            width: 100vw;
            height: 100vh;
            z-index: 10;
            pointer-events: none;
        }

        .top-hud {
            position: fixed;
            top: 8px;
            left: 8px;
            right: 8px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            z-index: 100;
            pointer-events: none;
        }

        .hud-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
            background: var(--neon-bg);
            border: 1px solid rgba(0, 255, 102, 0.55);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.65);
            padding: 6px 10px;
            border-radius: 7px;
            pointer-events: auto;
            backdrop-filter: blur(6px);
        }

        .status-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            font-weight: bold;
            color: #eafff0;
        }

        .live-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 2px 7px;
            border-radius: 4px;
            font-size: 11px;
            background: rgba(0, 255, 102, 0.2);
            border: 1px solid var(--neon);
            color: var(--neon);
        }

        .live-badge.replay {
            background: rgba(255, 170, 0, 0.25);
            border-color: var(--warn-amber);
            color: var(--warn-amber);
        }

        .live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--neon);
            box-shadow: 0 0 8px var(--neon);
        }

        .loc-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 5px;
        }

        .radar-btn {
            background: rgba(12, 32, 18, 0.92);
            color: #dfffee;
            border: 1px solid rgba(0, 255, 102, 0.5);
            padding: 5px 8px;
            font-size: 11px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .radar-btn:hover { background: rgba(0, 255, 102, 0.25); }

        .radar-btn.active {
            background: var(--neon);
            color: #031a0b;
            border-color: var(--neon);
            box-shadow: 0 0 10px rgba(0, 255, 102, 0.5);
        }

        .radar-btn.loc-btn {
            border-color: #00e5ff;
            color: #99f5ff;
        }

        .radar-btn.loc-btn.active {
            background: #00e5ff;
            color: #001a22;
            border-color: #00e5ff;
            box-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
        }

        .radar-btn.mil-btn {
            border-color: var(--mil-red);
            color: #ff8888;
        }

        .radar-btn.mil-btn.active {
            background: var(--mil-red);
            color: #fff;
            box-shadow: 0 0 10px rgba(255, 34, 34, 0.6);
        }

        .radar-btn.amber-btn {
            border-color: var(--warn-amber);
            color: var(--warn-amber);
        }

        .radar-btn.amber-btn.active {
            background: var(--warn-amber);
            color: #1a0f00;
            box-shadow: 0 0 10px rgba(255, 170, 0, 0.6);
        }

        #btn-gyro {
            border-color: #00ffff;
            color: #00ffff;
            background: rgba(0, 35, 45, 0.9);
        }
        #btn-gyro.active {
            background: #00ffff;
            color: #000;
            box-shadow: 0 0 12px #00ffff;
        }

        .pinned-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            background: rgba(25, 0, 35, 0.92);
            padding: 4px 8px;
            border-radius: 6px;
            border: 1px solid rgba(255, 0, 255, 0.5);
            color: #ff99ff;
            pointer-events: auto;
            font-weight: bold;
        }

        .hud-mini-btn {
            background: rgba(75, 0, 90, 0.9);
            border: 1px solid #ff33cc;
            color: #ffccff;
            font-size: 10px;
            font-weight: bold;
            padding: 3px 8px;
            border-radius: 4px;
            cursor: pointer;
        }

        .reset-tracks-btn {
            background: rgba(130, 0, 30, 0.95);
            border-color: #ff3355;
            color: #ffffff;
        }

        .pinned-bar {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 4px;
            pointer-events: auto;
            max-height: 54px;
            overflow-y: auto;
            padding-right: 2px;
            transition: max-height 0.2s ease;
        }

        .pinned-bar.expanded {
            max-height: 195px;
            background: rgba(12, 0, 18, 0.94);
            padding: 5px;
            border: 1px solid rgba(255, 0, 255, 0.5);
            border-radius: 6px;
        }

        .pin-slot {
            background: rgba(25, 0, 35, 0.88);
            border: 1px dashed rgba(255, 0, 255, 0.45);
            color: #cc88cc;
            padding: 4px 6px;
            font-family: monospace;
            font-size: 10.5px;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pin-slot.filled {
            background: rgba(75, 0, 95, 0.96);
            border: 1px solid #ff00ff;
            color: #ffffff;
            box-shadow: 0 0 8px rgba(255, 0, 255, 0.4);
        }

        .pin-slot.alert {
            background: rgba(150, 0, 0, 0.96);
            border-color: #ff0000;
            color: #ffff00;
            animation: blinkAlert 0.7s infinite alternate;
        }

        @keyframes blinkAlert {
            from { box-shadow: 0 0 4px #ff0000; }
            to { box-shadow: 0 0 16px #ff0000; background: rgba(200, 0, 0, 1); }
        }

        .map-side-controls {
            position: fixed;
            right: 12px;
            top: 55%;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 100;
        }

        .circle-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: rgba(20, 30, 24, 0.9);
            border: 1px solid rgba(0, 255, 102, 0.5);
            color: #fff;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(0,0,0,0.6);
        }

        /* МАШИНА НА ВРЕМЕТО (ИСТОРИЯ ПАНЕЛ) */
        #timeMachineDock {
            position: fixed;
            bottom: 70px;   /* беше 14px */
            right: 14px;
            width: 420px;
            max-width: calc(100vw - 28px);
            background: rgba(18, 12, 8, 0.96);
            border: 2px solid var(--warn-amber);
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.85);
            border-radius: 9px;
            padding: 10px 12px;
            z-index: 210;
            display: none;
            backdrop-filter: blur(8px);
        }

        .tm-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-size: 12px;
            color: var(--warn-amber);
            font-weight: bold;
        }

        .tm-slider-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
        }

        #historySlider {
            flex: 1;
            accent-color: var(--warn-amber);
            cursor: pointer;
        }

        .tm-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
        }

        /* ДОЛЕН ИНФОРМАЦИОНЕН ПАНЕЛ ЗА САМОЛЕТА */
        #infoPanel {
            position: fixed;
            bottom: 14px;
            left: 14px;
            background: rgba(4, 18, 9, 0.97);
            border: 2px solid var(--neon);
            box-shadow: 0 0 25px rgba(0, 255, 68, 0.45);
            padding: 10px 12px;
            border-radius: 8px;
            display: none;
            width: 95%;
            max-width: 440px;
            font-size: 12px;
            z-index: 200;
        }

        #infoPanel.mil-panel {
            border-color: var(--mil-red);
            box-shadow: 0 0 25px rgba(255, 34, 34, 0.55);
        }

        .plane-card-header {
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(0, 255, 0, 0.3);
            padding-bottom: 6px;
            margin-bottom: 6px;
            gap: 10px;
            padding-right: 40px;
        }

        .plane-photo-box {
            width: 86px;
            height: 56px;
            min-width: 86px;
            background: radial-gradient(circle, rgba(0,60,0,0.6) 0%, rgba(0,15,0,0.95) 100%);
            border: 1px solid var(--neon);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .plane-photo-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        .route-banner {
            background: rgba(0, 50, 40, 0.7);
            border: 1px solid rgba(0, 255, 200, 0.4);
            padding: 4px 7px;
            border-radius: 4px;
            margin-bottom: 6px;
            font-size: 11px;
            color: #00ffcc;
            font-weight: bold;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px 8px;
        }

        .info-item {
            background: rgba(0, 255, 0, 0.07);
            padding: 5px 7px;
            border-radius: 4px;
            border-left: 3px solid var(--neon);
        }

        .info-label {
            font-size: 9.5px;
            color: #88cc99;
            text-transform: uppercase;
            display: block;
        }

        .info-val {
            font-size: 12px;
            color: #ffffff;
            font-weight: bold;
        }

        .auto-track-btn {
            width: 100%;
            margin-top: 7px;
            background: rgba(75, 0, 95, 0.95);
            border: 1px solid #ff00ff;
            color: #ffffff;
            font-family: monospace;
            font-size: 11.5px;
            font-weight: bold;
            padding: 7px;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
        }

        .auto-track-btn.active {
            background: #ff00ff;
            color: #000;
            box-shadow: 0 0 12px #ff00ff;
        }

        .mark-targets-row {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 3px;
            margin-top: 6px;
            padding-top: 5px;
            border-top: 1px solid rgba(0, 255, 0, 0.25);
        }

        .mark-btn {
            background: rgba(35, 0, 45, 0.85);
            border: 1px solid #cc00cc;
            color: #ff77ff;
            font-family: monospace;
            font-size: 9.5px;
            font-weight: bold;
            padding: 4px 1px;
            border-radius: 3px;
            cursor: pointer;
        }

        .mark-btn.occupied {
            background: rgba(75, 15, 90, 0.9);
            border-color: #ff66ff;
            color: #ffffff;
        }

        .mark-btn.active {
            background: #ff00ff;
            color: #000;
        }

        .panel-top-actions {
            position: absolute;
            top: 8px;
            right: 10px;
            display: flex;
            gap: 5px;
        }

        .action-btn {
            background: rgba(0, 40, 0, 0.85);
            border: 1px solid #0f0;
            color: #0f0;
            font-size: 12px;
            font-weight: bold;
            padding: 3px 8px;
            border-radius: 4px;
            cursor: pointer;
        }

        .leaflet-control-attribution { display: none !important; }
    </style>
</head>
<body class="map-tactical-filter">

<div id="terrainMap"></div>
<canvas id="radarCanvas"></canvas>

<!-- ГОРЕН ТАКТИЧЕСКИ ПАНЕЛ -->
<div class="top-hud">
    <div class="hud-row">
        <div class="status-header">
            <span id="modeBadge" class="live-badge">
                <span class="live-dot"></span>
                <span id="modeText">LIVE</span>
            </span>
            <span id="gpsText" style="color:#00e5ff;">📍 БАЗА: с. Радишево</span>
            <span>ЦЕЛИ: <strong id="planesCount" style="color:#ffdd00;">0</strong></span>
            <span>ВОЕННИ: <strong id="milCount" style="color:#ff4444;">0</strong></span>
            <span id="clockDisplay">--:--:--</span>
        </div>

        <div class="loc-bar">
            <button class="radar-btn loc-btn active" id="locRadishevo" onclick="setBaseLocation(43.3676, 24.6667, 'с. Радишево', 'locRadishevo')">📍 РАДИШЕВО</button>
            <button class="radar-btn loc-btn" id="locPleven" onclick="setBaseLocation(43.4170, 24.6067, 'гр. Плевен', 'locPleven')">📍 ПЛЕВЕН</button>
            <button class="radar-btn loc-btn" id="locEmona" onclick="setBaseLocation(42.7136, 27.8986, 'нос ЕМОНА', 'locEmona')">🌊 ЕМОНА</button>
            <button class="radar-btn loc-btn" id="locGps" onclick="activateRealGps()">📡 АВТО GPS</button>
            <button class="radar-btn loc-btn" id="locCenter" onclick="setBaseFromMapCenter()" title="Вземи центъра на картата за твоя база">🎯 ЦЕНТЪР КАРТА</button>
            <button class="radar-btn loc-btn" id="locManual" onclick="promptManualCoords()">✍️ КООРДИНАТИ</button>
        </div>

        <div class="loc-bar">
            <button class="radar-btn" id="btn-gyro" onclick="toggleGyroCompass()">🧭 СЕВЕР: ИСТИНСКИ (0°)</button>
            <button class="radar-btn mil-btn" id="btnMilOnly">⚔️ ВОЕННИ</button>
            <button class="radar-btn amber-btn" id="btnHistory" title="Машина на времето (MySQL / Архив)">⏪ ИСТОРИЯ</button>
            <button class="radar-btn active" id="btnBorder">🟥 БГ ГРАНИЦА</button>
            <button class="radar-btn mil-btn active" id="btnSweep">📡 ЧЕРВЕН ЛЪЧ</button>
            <button class="radar-btn" id="btnMapStyle">🗺️ РЕЛЕФ</button>
        </div>
    </div>

    <!-- Оперативно водене и маркиране на цели -->
    <div class="pinned-header">
        <span id="trackCounterInfo">🎯 МАРКИРАНИ ЦЕЛИ: 0/21 | Следваща: #1</span>
        <div style="display:flex; gap:5px;">
            <button class="hud-mini-btn" id="toggleSlotsBtn" onclick="toggleExpandSlots()">▼ РАЗГЪНИ (21)</button>
            <button class="hud-mini-btn reset-tracks-btn" onclick="resetAllTrackedTargets()">🗑️ РАЗМАРКИРАЙ ВСИЧКИ</button>
        </div>
    </div>

    <div class="pinned-bar" id="pinnedBarContainer">
        {% for i in 1..21 %}
            <button class="pin-slot" id="pin-slot-{{ i }}" onclick="selectPinnedTarget({{ i }})">Цел #{{ i }}: -</button>
        {% endfor %}
    </div>
</div>

<div class="map-side-controls">
    <button class="circle-btn" id="btnZoomIn">+</button>
    <button class="circle-btn" id="btnZoomOut">−</button>
    <button class="circle-btn" id="btnMyLoc">➤</button>
</div>

<!-- МАШИНА НА ВРЕМЕТО (ИСТОРИЯ НА ПОЛЕТИТЕ) -->
<div id="timeMachineDock">
    <div class="tm-header">
        <span>⏪ ИСТОРИЯ НА ПОЛЕТИТЕ (АРХИВ)</span>
        <span id="tmTimestampLabel">НА ЖИВО</span>
    </div>
    <div class="tm-slider-wrap">
        <span style="font-size:11px; color:#ccc;">НАЗАД</span>
        <input type="range" id="historySlider" min="0" max="0" value="0">
        <span style="font-size:11px; color:#ccc;">СЕГА</span>
    </div>
    <div class="tm-controls">
        <div style="display:flex; gap:6px;">
            <button class="radar-btn amber-btn" id="btnPlayHistory">▶ ПУСНИ</button>
            <button class="radar-btn" id="btnSpeedHistory">1x</button>
        </div>
        <span id="tmFramesCount" style="font-size:11px; color:#ccc;">Записи в БД: 0</span>
        <button class="radar-btn active" id="btnBackToLive">🔴 НА ЖИВО</button>
    </div>
</div>

<div id="infoPanel"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let myLat = 43.3676;
    let myLon = 24.6667;
    let myBaseName = 'с. Радишево';
    let gpsWatchId = null;

    // МАГНИТЕН СЕВЕР ЛОГИКА
    let useMagneticNorth = false;
    const BG_MAGNETIC_DECLINATION = 5.5;

    function getAzimuthCorrectionDeg() {
        return useMagneticNorth ? -BG_MAGNETIC_DECLINATION : 0.0;
    }

    window.toggleGyroCompass = function() {
        useMagneticNorth = !useMagneticNorth;
        const btn = document.getElementById('btn-gyro');
        if (useMagneticNorth) {
            btn.classList.add('active');
            btn.innerText = '🧭 СЕВЕР: МАГНИТЕН (-5.5°)';
        } else {
            btn.classList.remove('active');
            btn.innerText = '🧭 СЕВЕР: ИСТИНСКИ (0°)';
        }
        if (selectedPlaneId) {
            const sel = planes.find(p => p.id === selectedPlaneId);
            if (sel) updateInfoPanelHTML(sel);
        }
    };

    const map = L.map('terrainMap', { center: [myLat, myLon], zoom: 8, zoomControl: false, attributionControl: false });
    const googleTerrainLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}&hl=bg', { maxZoom: 18, subdomains: ['mt0', 'mt1', 'mt2', 'mt3'] });
    const googleHybridLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}&hl=bg', { maxZoom: 18, subdomains: ['mt0', 'mt1', 'mt2', 'mt3'] });
    const openTopoLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', { maxZoom: 17 });
    googleTerrainLayer.addTo(map);
    let currentMapMode = 0;

    const fallbackBgBorder = [
        [44.21, 22.67], [44.04, 22.94], [43.82, 23.25], [43.78, 23.82], [43.69, 24.47], [43.74, 24.89],
        [43.63, 25.37], [43.68, 25.63], [43.85, 25.95], [44.05, 26.27], [44.13, 26.65], [44.12, 27.27],
        [43.83, 27.67], [43.74, 28.05], [43.74, 28.58], [43.54, 28.61], [43.37, 28.08], [43.19, 27.92],
        [42.85, 27.89], [42.66, 27.72], [42.42, 27.78], [42.09, 27.96], [41.98, 28.02], [41.96, 27.65],
        [42.01, 27.18], [41.87, 26.95], [41.99, 26.59], [41.71, 26.35], [41.58, 26.15], [41.32, 26.12],
        [41.29, 25.75], [41.24, 25.29], [41.36, 24.85], [41.45, 24.42], [41.55, 24.06], [41.38, 23.85],
        [41.34, 23.22], [41.37, 22.95], [41.71, 22.97], [41.99, 22.87], [42.22, 22.52], [42.32, 22.36],
        [42.56, 22.44], [42.87, 22.66], [43.01, 22.81], [43.19, 22.65], [43.39, 22.56], [43.68, 22.41],
        [43.81, 22.36], [44.03, 22.65], [44.21, 22.67]
    ];

    let bgBorderLayer = L.polygon(fallbackBgBorder, {
        color: '#ff1111', weight: 3.5, opacity: 0.95, fillColor: '#ff0000', fillOpacity: 0.04, className: 'bg-border-glow'
    }).addTo(map);

    fetch('https://raw.githubusercontent.com/johan/world.geo.json/master/countries/BGR.geo.json')
        .then(r => r.json())
        .then(geoData => {
            if (map.hasLayer(bgBorderLayer)) map.removeLayer(bgBorderLayer);
            bgBorderLayer = L.geoJSON(geoData, {
                style: { color: '#ff1111', weight: 3.5, opacity: 0.95, fillColor: '#ff0000', fillOpacity: 0.04, className: 'bg-border-glow' }
            });
            if (showBorder) bgBorderLayer.addTo(map);
        }).catch(() => {});

    let showBorder = true;

    function highlightLocBtn(activeId) {
        document.querySelectorAll('.loc-btn').forEach(b => b.classList.remove('active'));
        const el = document.getElementById(activeId);
        if (el) el.classList.add('active');
    }

    window.setBaseLocation = function(lat, lon, label, btnId) {
        if (gpsWatchId !== null && navigator.geolocation) {
            navigator.geolocation.clearWatch(gpsWatchId);
            gpsWatchId = null;
        }
        myLat = parseFloat(lat);
        myLon = parseFloat(lon);
        myBaseName = label;
        document.getElementById('gpsText').textContent = `📍 БАЗА: ${label} (${myLat.toFixed(2)}, ${myLon.toFixed(2)})`;
        if (btnId) highlightLocBtn(btnId);
        map.setView([myLat, myLon], map.getZoom());
        fetchPlanes(true);
    };

    window.setBaseFromMapCenter = function() {
        const c = map.getCenter();
        window.setBaseLocation(c.lat, c.lng, 'Център карта', 'locCenter');
    };

    window.promptManualCoords = function() {
        const input = prompt('Въведи координати (Ширина, Дължина) - напр. 42.7136, 27.8986 за Емона:', `${myLat.toFixed(4)}, ${myLon.toFixed(4)}`);
        if (!input) return;
        const parts = input.split(/[ ,;]+/);
        if (parts.length >= 2) {
            const lat = parseFloat(parts[0]);
            const lon = parseFloat(parts[1]);
            if (!isNaN(lat) && !isNaN(lon)) {
                window.setBaseLocation(lat, lon, 'Ръчна точка', 'locManual');
            }
        }
    };

    window.activateRealGps = function() {
        highlightLocBtn('locGps');
        document.getElementById('gpsText').textContent = '📡 Търсене на GPS...';
        if (!navigator.geolocation) return alert('Няма GPS поддръжка.');
        gpsWatchId = navigator.geolocation.watchPosition(
            (pos) => {
                myLat = pos.coords.latitude;
                myLon = pos.coords.longitude;
                myBaseName = 'АВТО GPS';
                document.getElementById('gpsText').textContent = `📡 GPS АКТИВЕН (${myLat.toFixed(3)}, ${myLon.toFixed(3)})`;
                map.panTo([myLat, myLon]);
                fetchPlanes(true);
            },
            (err) => alert('GPS блокиран. Натисни бутона 🌊 ЕМОНА или 🎯 ЦЕНТЪР КАРТА!'),
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 5000 }
        );
    };

    const TOTAL_PIN_SLOTS = 21;
    const ALL_SLOTS = Array.from({ length: TOTAL_PIN_SLOTS }, (_, i) => i + 1);
    let pinnedTargets = {};
    ALL_SLOTS.forEach(s => { pinnedTargets[s] = null; });
    let highestTrackNumber = 0;
    let slotsExpanded = false;

    const planePhotoCache = {};
    const planeRouteCache = {};

    try {
        const savedPins = localStorage.getItem('radar_pinned_targets_21');
        const savedCounter = localStorage.getItem('radar_highest_track_num_21');
        if (savedPins) {
            const parsed = JSON.parse(savedPins);
            ALL_SLOTS.forEach(s => { pinnedTargets[s] = parsed[s] || null; });
        }
        if (savedCounter) highestTrackNumber = parseInt(savedCounter, 10) || 0;
    } catch (e) {}

    function savePinState() {
        try {
            localStorage.setItem('radar_pinned_targets_21', JSON.stringify(pinnedTargets));
            localStorage.setItem('radar_highest_track_num_21', String(highestTrackNumber));
        } catch (e) {}
    }

    function checkAutoResetCounter() {
        const anyActive = ALL_SLOTS.some(s => pinnedTargets[s] !== null);
        if (!anyActive) highestTrackNumber = 0;
    }

    function getPinDataForPlane(planeId) {
        if (!planeId) return null;
        for (let slot of ALL_SLOTS) {
            if (pinnedTargets[slot] && pinnedTargets[slot].id === planeId) return { slot: slot, trackNum: pinnedTargets[slot].trackNum };
        }
        return null;
    }

    window.toggleExpandSlots = function() {
        slotsExpanded = !slotsExpanded;
        document.getElementById('pinnedBarContainer').classList.toggle('expanded', slotsExpanded);
        document.getElementById('toggleSlotsBtn').innerText = slotsExpanded ? '▲ СВИЙ (6)' : '▼ РАЗГЪНИ (21)';
    };

    window.togglePinSlot = function(slot, planeId) {
        if (pinnedTargets[slot] && pinnedTargets[slot].id === planeId) {
            pinnedTargets[slot] = null;
            checkAutoResetCounter();
        } else {
            for (let s of ALL_SLOTS) { if (pinnedTargets[s] && pinnedTargets[s].id === planeId) pinnedTargets[s] = null; }
            checkAutoResetCounter();
            highestTrackNumber++;
            pinnedTargets[slot] = { id: planeId, trackNum: highestTrackNumber };
        }
        savePinState();
        updatePinnedBarUI();
        if (selectedPlaneId) {
            const sel = planes.find(p => p.id === selectedPlaneId);
            if (sel) updateInfoPanelHTML(sel);
        }
    };

    window.autoAssignNextTrack = function(planeId) {
        const existing = getPinDataForPlane(planeId);
        if (existing) {
            pinnedTargets[existing.slot] = null;
            checkAutoResetCounter();
        } else {
            let targetSlot = ALL_SLOTS.find(s => pinnedTargets[s] === null) || 1;
            highestTrackNumber++;
            pinnedTargets[targetSlot] = { id: planeId, trackNum: highestTrackNumber };
        }
        savePinState();
        updatePinnedBarUI();
        if (selectedPlaneId) {
            const sel = planes.find(p => p.id === selectedPlaneId);
            if (sel) updateInfoPanelHTML(sel);
        }
    };

    window.resetAllTrackedTargets = function() {
        ALL_SLOTS.forEach(s => { pinnedTargets[s] = null; });
        highestTrackNumber = 0;
        savePinState();
        updatePinnedBarUI();
        if (selectedPlaneId) {
            const sel = planes.find(p => p.id === selectedPlaneId);
            if (sel) updateInfoPanelHTML(sel);
        }
    };

    window.selectPinnedTarget = function(slot) {
        const slotObj = pinnedTargets[slot];
        if (!slotObj || !slotObj.id) return;
        const found = planes.find(p => p.id === slotObj.id);
        if (found) {
            selectedPlaneId = found.id;
            map.panTo([found.lat, found.lon]);
            updateInfoPanelHTML(found);
        } else {
            pinnedTargets[slot] = null;
            checkAutoResetCounter();
            savePinState();
            updatePinnedBarUI();
        }
    };

    function updatePinnedBarUI() {
        checkAutoResetCounter();
        let activePinnedCount = 0;
        for (let slot of ALL_SLOTS) {
            const btn = document.getElementById(`pin-slot-${slot}`);
            if (!btn) continue;
            const slotObj = pinnedTargets[slot];
            const p = (slotObj && slotObj.id) ? planes.find(pl => pl.id === slotObj.id) : null;
            btn.classList.remove('filled', 'alert');
            if (p && slotObj) {
                activePinnedCount++;
                btn.classList.add('filled');
                const cleanName = (p.callsign || p.id).replace(' [ВОЕНЕН]', '');
                const sqk = (p.squawk && p.squawk !== '----') ? p.squawk : cleanName;
                btn.innerText = `🎯#${slotObj.trackNum}: ${sqk} (${(p.distKm || 0).toFixed(0)}km)`;
            } else {
                btn.innerText = `Цел #${slot}: -`;
            }
        }
        document.getElementById('trackCounterInfo').innerText = `🎯 МАРКИРАНИ ЦЕЛИ: ${activePinnedCount}/${TOTAL_PIN_SLOTS} | Следваща: #${highestTrackNumber + 1}`;
    }

    const canvas = document.getElementById('radarCanvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    let planes = [];
    let selectedPlaneId = null;
    let showSweep = true;
    let milOnlyFilter = false;
    let sweepAngle = 0;
    let isFetchingPlanes = false;

    // МАШИНА НА ВРЕМЕТО ПРОМЕНЛИВИ
    let isReplayMode = false;
    let historyTimestamps = [];
    let replayPlaying = false;
    let replaySpeed = 1;
    let replayTimer = null;

    function calcDistanceKm(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = (lat2 - lat1) * Math.PI / 180;
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function calcBearing(lat1, lon1, lat2, lon2) {
        const dLon = (lon2 - lon1) * Math.PI / 180;
        const y = Math.sin(dLon) * Math.cos(lat2 * Math.PI / 180);
        const x = Math.cos(lat1 * Math.PI / 180) * Math.sin(lat2 * Math.PI / 180) - Math.sin(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.cos(dLon);
        const trueAzi = Math.round((Math.atan2(y, x) * 180 / Math.PI + 360) % 360);
        return Math.round((trueAzi + getAzimuthCorrectionDeg() + 360) % 360);
    }

    function getInterpolatedLatLon(plane, nowMs) {
        if (isReplayMode || !plane.lastUpdateMs || !plane.speed || plane.speed < 25) return { lat: plane.lat, lon: plane.lon };
        const dtSec = Math.min((nowMs - plane.lastUpdateMs) / 1000, 25.0);
        const distKm = (plane.speed / 3600) * dtSec;
        const rad = (plane.track || 0) * Math.PI / 180;
        const dLat = (distKm * Math.cos(rad)) / 111.32;
        const dLon = (distKm * Math.sin(rad)) / (111.32 * Math.cos(plane.lat * Math.PI / 180));
        return { lat: plane.lat + dLat, lon: plane.lon + dLon };
    }

    function drawRealisticPlane(x, y, trackDeg, isMil, isSelected, pinData) {
        ctx.save();
        ctx.translate(x, y);
        const visualTrack = ((trackDeg || 0) + getAzimuthCorrectionDeg() + 360) % 360;
        ctx.rotate(visualTrack * Math.PI / 180);

        const fillColor = isMil ? '#ff2222' : (pinData ? '#ff55ff' : (isSelected ? '#ffffff' : '#ffdd00'));
        ctx.fillStyle = fillColor;
        ctx.strokeStyle = '#111111';
        ctx.lineWidth = 1.6;
        ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
        ctx.shadowBlur = 5;

        ctx.beginPath();
        if (isMil) {
            ctx.moveTo(0, -14); ctx.lineTo(3.5, -4); ctx.lineTo(12, 4); ctx.lineTo(12, 7);
            ctx.lineTo(3.5, 5); ctx.lineTo(5, 12); ctx.lineTo(0, 9.5); ctx.lineTo(-5, 12);
            ctx.lineTo(-3.5, 5); ctx.lineTo(-12, 7); ctx.lineTo(-12, 4); ctx.lineTo(-3.5, -4);
        } else {
            ctx.moveTo(0, -13); ctx.lineTo(2.4, -8); ctx.lineTo(2.4, -2); ctx.lineTo(13, 3);
            ctx.lineTo(13, 5.5); ctx.lineTo(2.2, 2.5); ctx.lineTo(1.8, 9); ctx.lineTo(6, 11.5);
            ctx.lineTo(6, 13); ctx.lineTo(0, 11.5); ctx.lineTo(-6, 13); ctx.lineTo(-6, 11.5);
            ctx.lineTo(-1.8, 9); ctx.lineTo(-2.2, 2.5); ctx.lineTo(-13, 5.5); ctx.lineTo(-13, 3);
            ctx.lineTo(-2.4, -2); ctx.lineTo(-2.4, -8);
        }
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
        ctx.restore();

        if (isSelected || pinData) {
            ctx.save();
            ctx.strokeStyle = pinData ? '#ff00ff' : '#00ffff';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(x, y, 16, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();
        }
    }

    // ЧЕРВЕНИКАВА КОМПАСНА РЕШЕТКА С МАГНИТЕН/ИСТИНСКИ СЕВЕР
    function drawRadarGrid(cx, cy) {
        const radius = Math.min(canvas.width, canvas.height) * 0.42;
        ctx.save();
        ctx.translate(cx, cy);

        // Външен червен пръстен
        ctx.beginPath();
        ctx.arc(0, 0, radius, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 45, 45, 0.75)';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Вътрешен помощен пръстен
        ctx.beginPath();
        ctx.arc(0, 0, radius * 0.5, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255, 45, 45, 0.35)';
        ctx.lineWidth = 1;
        ctx.stroke();

        for (let i = 0; i < 360; i += 10) {
            const isMajor = (i % 30 === 0);
            const angleRad = (i - 90) * Math.PI / 180;
            const startR = isMajor ? radius - 13 : radius - 6;

            ctx.beginPath();
            ctx.moveTo(Math.cos(angleRad) * startR, Math.sin(angleRad) * startR);
            ctx.lineTo(Math.cos(angleRad) * radius, Math.sin(angleRad) * radius);
            ctx.strokeStyle = (i === 0) ? '#00e5ff' : (isMajor ? 'rgba(255, 60, 60, 0.9)' : 'rgba(255, 60, 60, 0.45)');
            ctx.lineWidth = isMajor ? 2.2 : 1.2;
            ctx.stroke();

            if (isMajor) {
                let labelNum = (i + getAzimuthCorrectionDeg() + 360) % 360;
                let labelText = (i === 0) ? (useMagneticNorth ? '0°М' : '0°С') : `${Math.round(labelNum)}°`;

                ctx.fillStyle = (i === 0) ? '#00e5ff' : '#ff4444';
                ctx.font = 'bold 11.5px monospace';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.shadowColor = '#000';
                ctx.shadowBlur = 4;
                ctx.fillText(labelText, Math.cos(angleRad) * (radius + 17), Math.sin(angleRad) * (radius + 17));
            }
        }

        ctx.beginPath();
        ctx.moveTo(-radius, 0); ctx.lineTo(radius, 0);
        ctx.moveTo(0, -radius); ctx.lineTo(0, radius);
        ctx.strokeStyle = 'rgba(255, 50, 50, 0.25)';
        ctx.lineWidth = 1;
        ctx.stroke();

        ctx.restore();
    }

    function renderLoop() {
        const nowMs = Date.now();

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const myScreenPt = map.latLngToContainerPoint([myLat, myLon]);

        // =========================================================
        // РАДАРНА РЕШЕТКА
        // =========================================================
        drawRadarGrid(myScreenPt.x, myScreenPt.y);

        // =========================================================
        // МОЯТА ПОЗИЦИЯ
        // =========================================================
        ctx.save();

        ctx.fillStyle = '#00e5ff';
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;

        ctx.beginPath();
        ctx.arc(
            myScreenPt.x,
            myScreenPt.y,
            7,
            0,
            Math.PI * 2
        );

        ctx.fill();
        ctx.stroke();

        ctx.font = 'bold 11px Segoe UI, sans-serif';
        ctx.fillStyle = '#00e5ff';

        ctx.fillText(
            `📍 ${myBaseName}`,
            myScreenPt.x + 10,
            myScreenPt.y + 4
        );

        ctx.restore();


        // =========================================================
        // ЧЕРВЕН РАДАРЕН ЛЪЧ
        // =========================================================
        if (showSweep) {

            const sweepRadius =
                Math.min(canvas.width, canvas.height) * 0.42;

            sweepAngle =
                (sweepAngle + 0.032) % (Math.PI * 2);

            ctx.save();

            ctx.translate(
                myScreenPt.x,
                myScreenPt.y
            );

            ctx.rotate(sweepAngle);

            const grad =
                ctx.createConicGradient(
                    -0.55,
                    0,
                    0
                );

            grad.addColorStop(
                0,
                'rgba(255, 20, 20, 0)'
            );

            grad.addColorStop(
                0.08,
                'rgba(255, 30, 30, 0.32)'
            );

            grad.addColorStop(
                0.14,
                'rgba(255, 45, 20, 0.72)'
            );

            grad.addColorStop(
                0.16,
                'rgba(255, 90, 50, 0.96)'
            );

            grad.addColorStop(
                0.165,
                'rgba(255, 20, 20, 0)'
            );

            ctx.fillStyle = grad;

            ctx.beginPath();

            ctx.arc(
                0,
                0,
                sweepRadius,
                -0.55,
                0
            );

            ctx.lineTo(0, 0);
            ctx.fill();


            // Ярка водеща линия
            ctx.beginPath();

            ctx.moveTo(0, 0);
            ctx.lineTo(sweepRadius, 0);

            ctx.strokeStyle = '#ff3322';
            ctx.shadowColor = '#ff0000';
            ctx.shadowBlur = 12;
            ctx.lineWidth = 3;

            ctx.stroke();

            ctx.restore();
        }


        // =========================================================
        // САМОЛЕТИ
        // =========================================================

        let totalCount = 0;
        let milCount = 0;

        planes.forEach(plane => {

            const isMil =
                plane.callsign &&
                plane.callsign.includes('[ВОЕНЕН]');

            const pinData =
                getPinDataForPlane(plane.id);


            // Ако е включен режим САМО ВОЕННИ
            if (
                milOnlyFilter &&
                !isMil &&
                !pinData
            ) {
                return;
            }


            totalCount++;

            if (isMil) {
                milCount++;
            }


            // =====================================================
            // ИНТЕРПОЛИРАНА ПОЗИЦИЯ
            // =====================================================

            const interp =
                getInterpolatedLatLon(
                    plane,
                    nowMs
                );

            const screenPt =
                map.latLngToContainerPoint([
                    interp.lat,
                    interp.lon
                ]);


            // =====================================================
            // ДИСТАНЦИЯ И АЗИМУТ
            // =====================================================

            plane.distKm =
                calcDistanceKm(
                    myLat,
                    myLon,
                    interp.lat,
                    interp.lon
                );

            plane.bearing =
                calcBearing(
                    myLat,
                    myLon,
                    interp.lat,
                    interp.lon
                );


            // ВАЖНО:
            // НЕ режем самолетите над 250 km.
            // Всички получени цели остават налични.


            plane.screenX =
                screenPt.x;

            plane.screenY =
                screenPt.y;


            const isSelected =
                plane.id === selectedPlaneId;


            // =====================================================
            // ЛИНИЯ ДО ИЗБРАНА / МАРКИРАНА ЦЕЛ
            // =====================================================

            if (
                isSelected ||
                pinData
            ) {

                ctx.save();

                ctx.beginPath();

                ctx.setLineDash([
                    5,
                    4
                ]);

                ctx.moveTo(
                    myScreenPt.x,
                    myScreenPt.y
                );

                ctx.lineTo(
                    screenPt.x,
                    screenPt.y
                );

                ctx.strokeStyle =
                    pinData
                        ? '#ff00ff'
                        : '#00ff66';

                ctx.lineWidth = 2;

                ctx.stroke();

                ctx.restore();
            }


            // =====================================================
            // РИСУВАМЕ САМОЛЕТА
            // =====================================================

            drawRealisticPlane(
                screenPt.x,
                screenPt.y,
                plane.track,
                isMil,
                isSelected,
                pinData
            );


            // =====================================================
            // ЕТИКЕТ - САМО SQK
            // =====================================================

            const hasSqk =
                plane.squawk &&
                plane.squawk !== '----' &&
                String(plane.squawk).trim() !== '';


            // Ако има SQK -> показваме само него.
            // Ако няма -> показваме ----
            const sqkText =
                hasSqk
                    ? String(plane.squawk)
                    : '----';


            ctx.save();

            // Малък шрифт, за да не претрупва картата
            ctx.font =
                'bold 11px Segoe UI, sans-serif';


            const textWidth =
                ctx.measureText(sqkText).width;

            const boxW =
                textWidth + 8;

            const boxH = 18;


            // =====================================================
            // МАЛКА КУТИЯ ДО САМОЛЕТА
            // =====================================================

            ctx.fillStyle =
                'rgba(0, 10, 4, 0.82)';


            // Цвят на рамката
            if (isMil) {

                ctx.strokeStyle =
                    '#ff2222';

            } else if (pinData) {

                ctx.strokeStyle =
                    '#ff00ff';

            } else {

                ctx.strokeStyle =
                    'rgba(0, 255, 102, 0.75)';
            }


            ctx.lineWidth = 1;


            ctx.fillRect(
                screenPt.x + 14,
                screenPt.y - 10,
                boxW,
                boxH
            );


            ctx.strokeRect(
                screenPt.x + 14,
                screenPt.y - 10,
                boxW,
                boxH
            );


            // =====================================================
            // SQK ТЕКСТ
            // =====================================================

            if (isMil) {

                // Военен
                ctx.fillStyle =
                    '#ff5555';

            } else if (pinData) {

                // Маркирана цел
                ctx.fillStyle =
                    '#ff88ff';

            } else {

                // Граждански
                ctx.fillStyle =
                    '#ffdd00';
            }


            ctx.fillText(
                sqkText,
                screenPt.x + 18,
                screenPt.y + 3
            );


            ctx.restore();
        });


        // =========================================================
        // БРОЯЧИ
        // =========================================================

        document
            .getElementById('planesCount')
            .textContent =
            totalCount;

        document
            .getElementById('milCount')
            .textContent =
            milCount;


        // =========================================================
        // СЛЕДВАЩ КАДЪР
        // =========================================================

        requestAnimationFrame(
            renderLoop
        );
    }

    map.on('click', function(e) {
        const clickX = e.containerPoint.x;
        const clickY = e.containerPoint.y;
        let closest = null, minDist = 28;

        planes.forEach(p => {
            const isMil = p.callsign && p.callsign.includes('[ВОЕНЕН]');
            const pinData = getPinDataForPlane(p.id);
            if (milOnlyFilter && !isMil && !pinData) return;
            const d = Math.hypot((p.screenX || 0) - clickX, (p.screenY || 0) - clickY);
            if (d < minDist) { minDist = d; closest = p; }
        });

        if (closest) {
            selectedPlaneId = closest.id;
            updateInfoPanelHTML(closest);
        } else {
            closeInfoPanel();
        }
    });

    async function fetchRealPlanePhoto(planeId) {
        if (!planeId) return;
        if (planePhotoCache[planeId] !== undefined) { applyPhotoToBox(planePhotoCache[planeId]); return; }
        try {
            const res = await fetch(`https://api.planespotters.net/pub/photos/hex/${planeId.toLowerCase()}`);
            const data = await res.json();
            if (data && data.photos && data.photos.length > 0) {
                const imgUrl = data.photos[0].thumbnail_large ? data.photos[0].thumbnail_large.src : data.photos[0].thumbnail.src;
                planePhotoCache[planeId] = imgUrl;
                if (selectedPlaneId === planeId) applyPhotoToBox(imgUrl);
            } else planePhotoCache[planeId] = null;
        } catch (err) { planePhotoCache[planeId] = null; }
    }

    function applyPhotoToBox(imgUrl) {
        const imgEl = document.getElementById('realPlaneImg');
        const svgEl = document.getElementById('fallbackPlaneSvg');
        if (imgEl && imgUrl) { imgEl.src = imgUrl; imgEl.style.display = 'block'; if (svgEl) svgEl.style.display = 'none'; }
    }

    async function fetchFlightRoute(plane) {
        if (!plane || !plane.callsign) return;
        const cleanCs = plane.callsign.replace(' [ВОЕНЕН]', '').trim();
        const isMil = plane.callsign.includes('[ВОЕНЕН]');
        if (planeRouteCache[plane.id] !== undefined) {
            const routeEl = document.getElementById('planeRouteText');
            if (routeEl) routeEl.innerText = planeRouteCache[plane.id]; return;
        }
        try {
            const res = await fetch(`https://api.adsbdb.com/v0/callsign/${encodeURIComponent(cleanCs)}`);
            if (res.ok) {
                const d = await res.json();
                const fr = d?.response?.flightroute;
                if (fr && fr.origin && fr.destination) planeRouteCache[plane.id] = `🛫 ${fr.origin.iata_code || fr.origin.municipality} ➔ 🛬 ${fr.destination.iata_code || fr.destination.municipality}`;
                else planeRouteCache[plane.id] = isMil ? '🔒 Военен / Тактически полет' : 'Маршрутът не е публикуван';
            } else planeRouteCache[plane.id] = isMil ? '🔒 Военен / Тактически полет' : 'Маршрутът не е публикуван';
        } catch (e) { planeRouteCache[plane.id] = 'Няма данни за маршрута'; }
        const routeEl = document.getElementById('planeRouteText');
        if (routeEl && selectedPlaneId === plane.id) routeEl.innerText = planeRouteCache[plane.id];
    }

    function updateInfoPanelHTML(p) {
        const panel = document.getElementById('infoPanel');
        const isMilitary = p.callsign && p.callsign.includes('[ВОЕНЕН]');
        panel.style.display = 'block';
        panel.classList.toggle('mil-panel', isMilitary);

        const color = isMilitary ? '#ff3333' : '#ffcc00';
        const badgeText = isMilitary ? 'ВОЕНЕН ОБЕКТ' : 'ГРАЖДАНСКИ ПОЛЕТ';
        const trackDeg = Math.round(p.track || 0);

        const cachedPhoto = planePhotoCache[p.id];
        const showImg = cachedPhoto ? 'display:block;' : 'display:none;';
        const showSvg = cachedPhoto ? 'display:none;' : 'display:block;';

        const pinData = getPinDataForPlane(p.id);
        const currentPinSlot = pinData ? pinData.slot : null;
        const nextAutoNum = highestTrackNumber + 1;

        const autoBtnText = pinData
            ? `🎯 МАРКИРАН КАТО ЦЕЛ #${pinData.trackNum} (СЛОТ ${pinData.slot}) — [РАЗМАРКИРАЙ]`
            : `📌 МАРКИРАЙ КАТО ЦЕЛ #${nextAutoNum}`;

        let slotButtonsHtml = '';
        for (let s of ALL_SLOTS) {
            const slotObj = pinnedTargets[s];
            const isThisPlane = (currentPinSlot === s);
            let btnLabel = `С${s}`;
            let extraClass = '';
            if (isThisPlane && slotObj) { btnLabel = `✓#${slotObj.trackNum}`; extraClass = 'active'; }
            else if (slotObj) { btnLabel = `${s}:#${slotObj.trackNum}`; extraClass = 'occupied'; }
            slotButtonsHtml += `<button class="mark-btn ${extraClass}" onclick="togglePinSlot(${s}, '${p.id}')">${btnLabel}</button>`;
        }

        const currentRoute = planeRouteCache[p.id] || 'Проверка на маршрут...';

        panel.innerHTML = `
            <div class="panel-top-actions">
                <button class="action-btn" onclick="closeInfoPanel()">✕</button>
            </div>
            <div class="plane-card-header">
                <div class="plane-photo-box">
                    <img id="realPlaneImg" src="${cachedPhoto || ''}" style="${showImg}" alt="Снимка" />
                    <svg id="fallbackPlaneSvg" viewBox="0 0 64 64" width="42" height="42" style="${showSvg} transform: rotate(${trackDeg}deg);">
                        <path fill="${color}" d="M32 4 L36 18 L58 30 L58 35 L36 31 L35 48 L45 55 L45 59 L32 56 L19 59 L19 55 L29 48 L28 31 L6 35 L6 30 L28 18 Z"/>
                    </svg>
                </div>
                <div>
                    <div style="font-size: 10px; color: ${color}; font-weight: bold;">● ${badgeText} ${pinData ? `| 🎯 ЦЕЛ #${pinData.trackNum}` : ''}</div>
                    <div style="font-weight: bold; font-size: 14px; color: #fff; margin: 2px 0;">
                        📡 ТРАНСПОНДЕР SQK: <span style="color:#00ffff;">${p.squawk || '----'}</span> | ✈ ${p.callsign}
                    </div>
                    <div style="font-size: 10.5px; color: #00ffcc; font-weight: bold;">HEX: ${p.id.toUpperCase()} | Модел: ${p.type || 'Няма данни'}</div>
                    <div style="font-size: 10px; color: #88ff88;">${p.operator || 'Неизвестен оператор'}</div>
                </div>
            </div>
            <div class="route-banner"><span id="planeRouteText">${currentRoute}</span></div>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">АЗИМУТ (${useMagneticNorth ? 'МАГНИТЕН' : 'ИСТИНСКИ'}) / РАЗСТ.</span>
                    <span class="info-val" style="color:#00ff66; font-size:13.5px;">AZ: ${p.bearing}° / ${(p.distKm || 0).toFixed(1)} км</span>
                </div>
                <div class="info-item">
                    <span class="info-label">КУРС / ВИСОЧИНА / СКОРОСТ</span>
                    <span class="info-val">${trackDeg}° | ${p.altitude || 0} м | ${p.speed || 0} км/ч</span>
                </div>
            </div>
            <button class="auto-track-btn ${pinData ? 'active' : ''}" onclick="autoAssignNextTrack('${p.id}')">${autoBtnText}</button>
            <div class="mark-targets-row">${slotButtonsHtml}</div>
        `;

        if (cachedPhoto === undefined) fetchRealPlanePhoto(p.id);
        if (planeRouteCache[p.id] === undefined) fetchFlightRoute(p);
    }

    window.closeInfoPanel = function() { selectedPlaneId = null; document.getElementById('infoPanel').style.display = 'none'; };

    function ingestPlanesData(data) {
        const now = Date.now();
        planes = data.map(item => {
            const distKm = calcDistanceKm(myLat, myLon, item.lat, item.lon);
            const bearing = calcBearing(myLat, myLon, item.lat, item.lon);
            return { ...item, distKm, bearing, lastUpdateMs: now };
        });
        updatePinnedBarUI();
        if (selectedPlaneId) {
            const sel = planes.find(p => p.id === selectedPlaneId);
            if (sel) updateInfoPanelHTML(sel);
        }
    }

    async function fetchPlanes(force = false) {
        if (isReplayMode || (isFetchingPlanes && !force)) return;
        isFetchingPlanes = true;
        try {
            const res = await fetch(`/api/planes?lat=${myLat.toFixed(4)}&lon=${myLon.toFixed(4)}${force ? '&force=1' : ''}`);
            if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data)) {
                    ingestPlanesData(data);
                }
            }
        } catch (e) {} finally { isFetchingPlanes = false; }
    }

    // МАШИНА НА ВРЕМЕТО (ИСТОРИЯ ФУНКЦИИ)
    async function syncHistoryMeta() {
        try {
            const res = await fetch('/api/history');
            if (!res.ok) return;
            const data = await res.json();
            if (Array.isArray(data.timestamps) && data.timestamps.length > 0) {
                historyTimestamps = data.timestamps;
                const slider = document.getElementById('historySlider');
                const atEnd = Number(slider.value) >= Number(slider.max) - 1;
                slider.max = historyTimestamps.length - 1;
                if (!isReplayMode || atEnd) slider.value = slider.max;
                document.getElementById('tmFramesCount').textContent = `Записи в БД: ${historyTimestamps.length}`;
            }
        } catch (e) {}
    }

    async function loadHistoryFrame(idx) {
        try {
            const res = await fetch(`/api/history?index=${idx}`);
            if (!res.ok) return;
            const frame = await res.json();
            if (frame && Array.isArray(frame.planes)) {
                isReplayMode = true;
                document.getElementById('modeBadge').classList.add('replay');
                document.getElementById('modeText').textContent = '⏪ REPLAY';
                const dt = new Date(frame.timestamp * 1000);
                document.getElementById('tmTimestampLabel').textContent = dt.toLocaleTimeString('bg-BG');
                ingestPlanesData(frame.planes);
            }
        } catch (e) {}
    }

    function stopReplay() {
        replayPlaying = false;
        document.getElementById('btnPlayHistory').textContent = '▶ ПУСНИ';
        if (replayTimer) {
            clearInterval(replayTimer);
            replayTimer = null;
        }
    }

    document.getElementById('btnHistory').onclick = function() {
        const dock = document.getElementById('timeMachineDock');
        const isOpen = dock.style.display === 'block';
        dock.style.display = isOpen ? 'none' : 'block';
        this.classList.toggle('active', !isOpen);
        if (!isOpen) syncHistoryMeta();
    };

    document.getElementById('historySlider').oninput = function() {
        stopReplay();
        loadHistoryFrame(Number(this.value));
    };

    document.getElementById('btnPlayHistory').onclick = function() {
        if (historyTimestamps.length === 0) return;
        if (replayPlaying) {
            stopReplay();
            return;
        }
        replayPlaying = true;
        this.textContent = '⏸ ПАУЗА';
        const slider = document.getElementById('historySlider');
        if (Number(slider.value) >= Number(slider.max)) slider.value = 0;

        replayTimer = setInterval(() => {
            let next = Number(slider.value) + 1;
            if (next > Number(slider.max)) {
                stopReplay();
                return;
            }
            slider.value = next;
            loadHistoryFrame(next);
        }, Math.round(1000 / replaySpeed));
    };

    document.getElementById('btnSpeedHistory').onclick = function() {
        const speeds = [1, 2, 5];
        replaySpeed = speeds[(speeds.indexOf(replaySpeed) + 1) % speeds.length];
        this.textContent = `${replaySpeed}x`;
    };

    document.getElementById('btnBackToLive').onclick = () => {
        stopReplay();
        isReplayMode = false;
        document.getElementById('modeBadge').classList.remove('replay');
        document.getElementById('modeText').textContent = 'LIVE';
        document.getElementById('tmTimestampLabel').textContent = 'НА ЖИВО';
        const slider = document.getElementById('historySlider');
        slider.value = slider.max;
        fetchPlanes(true);
    };

    document.getElementById('btnZoomIn').onclick = () => map.zoomIn();
    document.getElementById('btnZoomOut').onclick = () => map.zoomOut();
    document.getElementById('btnMyLoc').onclick = () => map.setView([myLat, myLon], 9);
    document.getElementById('btnMilOnly').onclick = function() { milOnlyFilter = !milOnlyFilter; this.classList.toggle('active', milOnlyFilter); };
    document.getElementById('btnBorder').onclick = function() { showBorder = !showBorder; if (showBorder) bgBorderLayer.addTo(map); else map.removeLayer(bgBorderLayer); this.classList.toggle('active', showBorder); };
    document.getElementById('btnSweep').onclick = function() { showSweep = !showSweep; this.classList.toggle('active', showSweep); };
    document.getElementById('btnMapStyle').onclick = function() {
        currentMapMode = (currentMapMode + 1) % 3;
        map.removeLayer(googleTerrainLayer); map.removeLayer(googleHybridLayer); map.removeLayer(openTopoLayer);
        if (currentMapMode === 0) { googleTerrainLayer.addTo(map); this.textContent = '🗺️ РЕЛЕФ'; }
        else if (currentMapMode === 1) { googleHybridLayer.addTo(map); this.textContent = '🛰️ САТЕЛИТ'; }
        else { openTopoLayer.addTo(map); this.textContent = '⛰️ ТОПО'; }
    };

    setInterval(() => {
        document.getElementById('clockDisplay').textContent = new Date().toLocaleTimeString('bg-BG');
    }, 1000);

    updatePinnedBarUI();
    requestAnimationFrame(renderLoop);
    fetchPlanes(true);
    syncHistoryMeta();
    setInterval(() => fetchPlanes(false), 5000);
    setInterval(syncHistoryMeta, 15000);
</script>
</body>
</html>
